# Copie ce fichier en .env (cp .env.example .env && chmod 600 .env), puis remplis-le.
# Mot de passe de l'administration : 12 caractères ou plus conseillés.
ADMIN_PASSWORD=
# Adresse secrète de l'administration, par exemple /gestion-7f3k9q2x
ADMIN_PATH=
# Derrière un reverse proxy (Nginx Proxy Manager, Traefik, Caddy…) : adresses des proxys
# à croire pour l'IP des visiteurs. Ne mets jamais « true » (n'importe qui pourrait se faire passer pour une autre IP).
# TRUST_PROXY=loopback, uniquelocal
# Adresse publique du site, pour les aperçus de partage (WhatsApp, LinkedIn…).
# SITE_URL=https://exemple.fr
# Port de l'hôte (3000 par défaut).
# HOST_PORT=3000
# Vérification des nouvelles versions de Folichon sur GitHub (false pour la désactiver).
# UPDATE_CHECK=true
