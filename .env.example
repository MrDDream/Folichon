# Copy this file to .env (cp .env.example .env && chmod 600 .env), then fill it in.
# Admin password: 12 characters or more recommended.
ADMIN_PASSWORD=
# Secret admin address, for example /admin-7f3k9q2x
ADMIN_PATH=
# Behind a reverse proxy (Nginx Proxy Manager, Traefik, Caddy…): proxies trusted for the
# visitor IP. Never use "true" (anyone could pretend to be another IP).
# TRUST_PROXY=loopback, uniquelocal
# Public address of the site, for share previews (WhatsApp, LinkedIn…).
# SITE_URL=https://example.com
# Host port (3000 by default).
# HOST_PORT=3000
# Check GitHub for new Folichon versions (false to turn it off).
# UPDATE_CHECK=true
