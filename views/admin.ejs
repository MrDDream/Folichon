<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Folichon · administration</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="/assets/css/admin.css?v=<%= assetVersion %>">
<script src="/assets/js/theme.js?v=<%= assetVersion %>"></script>
</head>
<body data-base="<%= base %>" data-social-types="<%= socialTypes.join(',') %>" data-icon-names="<%= iconNames.join(',') %>" data-font-presets="<%= JSON.stringify(fontPresets) %>">
<header class="topbar">
  <div class="topbar-inner">
    <span class="brand"><img src="/assets/folichon.svg" width="30" height="30" alt=""><span class="brand-name">Folichon</span></span>
    <a class="version hide-sm" data-version target="_blank" rel="noopener" hidden></a>
    <span id="status" class="status" aria-live="polite">Chargement…</span>
    <div class="actions">
      <%- include('partials/admin-controls', { cls: 'hide-sm' }) %>
      <a class="btn btn-quiet hide-sm" href="/" target="_blank" rel="noopener" data-i18n>Voir le site ↗</a>
      <details class="menu" id="menu">
        <summary class="btn btn-quiet" data-i18n-label="Plus d'actions" data-i18n-title="Plus d'actions">⋯</summary>
        <div class="menu-list">
          <div class="menu-row show-sm"><%- include('partials/admin-controls', { cls: '' }) %></div>
          <a class="show-sm" href="/" target="_blank" rel="noopener" data-i18n>Voir le site ↗</a>
          <button type="button" id="export" data-i18n>Exporter (contenu et images)</button>
          <label for="import" data-i18n>Importer un fichier…</label>
          <form method="post" action="<%= base %>/logout">
            <button type="submit" class="danger" data-i18n>Se déconnecter</button>
          </form>
          <a class="version menu-version show-sm" data-version target="_blank" rel="noopener" hidden></a>
        </div>
      </details>
      <input type="file" id="import" accept=".zip,.json,application/zip,application/json" hidden>
      <button type="button" class="btn btn-primary" id="save" disabled data-i18n data-i18n-title="Enregistrer (Ctrl + S)">Enregistrer</button>
    </div>
  </div>
</header>
<div class="layout">
  <nav class="sidenav" id="sidenav" data-i18n-label="Sections"></nav>
  <main id="editor" class="editor"></main>
</div>
<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
<script src="/assets/js/admin.js?v=<%= assetVersion %>" type="module"></script>
</body>
</html>
